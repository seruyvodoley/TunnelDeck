[Unit]
Description=TunnelDeck read-only monitoring agent
After=network.target

[Service]
Type=oneshot
User=tunneldeck-agent
Group=tunneldeck-agent
ExecStart=/usr/local/libexec/tunneldeck-agent collect
# Exact sudoers read commands require privilege transition; all other writes remain denied.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/tunneldeck
# The agent itself stays unprivileged. SETUID/SETGID/AUDIT_WRITE let sudo cross
# the exact collector allowlist; NET_ADMIN lets only those root children read netlink.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE CAP_NET_ADMIN
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
