# Exact read-only evidence commands required by tunneldeck-agent.
tunneldeck-agent ALL=(root) NOPASSWD: /usr/bin/wg show all dump
tunneldeck-agent ALL=(root) NOPASSWD: /usr/sbin/nft list ruleset
tunneldeck-agent ALL=(root) NOPASSWD: /usr/bin/sha256sum /etc/wireguard/wg0.conf
tunneldeck-agent ALL=(root) NOPASSWD: /usr/bin/sha256sum /opt/AdGuardHome/AdGuardHome.yaml
